# Line endings. Git on Windows checks out text files with CRLF by
# default, which silently changes bytes the deterministic renderer
# hashes and the quality gates scan — two developers on different
# platforms would otherwise produce different output from identical
# content. Pin LF for everything the build reads or writes.
* text=auto eol=lf

# Explicitly LF, whatever a contributor's local setting says.
*.sh          text eol=lf
*.mjs         text eol=lf
*.js          text eol=lf
*.json        text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.css         text eol=lf
*.html        text eol=lf
*.md          text eol=lf
Dockerfile*   text eol=lf
Caddyfile     text eol=lf

# Binary assets: never touched.
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.woff2       binary
*.pdf         binary
*.zip         binary
