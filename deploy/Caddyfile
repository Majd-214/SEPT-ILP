# Reverse proxy for the SEPT Interactive Laboratory Platform.
#
# Students touch only the first block: static files from the current
# release, served with no cookies and no auth — the platform's
# zero-student-data invariant is visible right here. Everything else
# (the faculty console, keys, the marker) proxies to the platform.
#
# TLS: this pilot listens on plain :8080 behind the operator's choice
# of edge. Giving Caddy a real hostname (replace `:8080` with it)
# turns on automatic HTTPS with no other change.

{
	auto_https off
}

:8080 {
	# ── Student site: /c/<course>/… → <course>/site/… in the release ──
	@site {
		method GET HEAD
		path_regexp course ^/c/([a-z][a-z0-9-]*)/(.*)$
	}
	handle @site {
		root * /data/current
		rewrite * /{re.course.1}/site/{re.course.2}
		try_files {path} {path}index.html
		@exists file
		handle @exists {
			file_server
		}
		# Not a file in the release — e.g. the /c/<course>/<lab>/
		# canonical shorthand. The platform answers (redirect or 404);
		# it too serves only files on this path.
		handle {
			rewrite * /c/{re.course.1}/{re.course.2}
			reverse_proxy platform:3000
		}
	}

	# ── Faculty console, auth, keys, marker ──────────────────────────
	handle {
		reverse_proxy platform:3000
	}
}
