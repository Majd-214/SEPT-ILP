# The platform container. The Playwright base image carries the
# browsers the accessibility gate drives during publishes, plus a
# current Node — publishing inside the container runs the SAME gate
# set as CI and a developer laptop; no gate is weakened in deployment.
# Pin the tag to the playwright version in the repository's root
# package.json so the installed library matches the baked browsers.
FROM mcr.microsoft.com/playwright:v1.62.1-noble

# The editor commits content changes; publishes optionally pull.
RUN apt-get update && apt-get install -y --no-install-recommends git \
  && rm -rf /var/lib/apt/lists/*

# The repository is bind-mounted at /app (the editor needs the live
# working copy, and Git stays the source of truth on the host).
WORKDIR /app

# Dependencies install at container start (into the mounted repo) so
# the image never goes stale against package-lock changes; see
# entrypoint.sh. Browsers are already in the image.
ENV PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1
ENV CI=1

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
EXPOSE 3000
ENTRYPOINT ["/entrypoint.sh"]
