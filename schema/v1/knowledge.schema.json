{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://majd-214.github.io/SEPT-ILP/schema/v1/knowledge.schema.json",
  "title": "SEPT-ILP knowledge domain v1",
  "description": "One domain of the course knowledge base: a set of reusable topics students reach through deep links at the moment of need. Topic ids are globally unique across all domains of a course.",
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 2 },
    "blurb": {
      "$ref": "blocks.schema.json#/$defs/richText",
      "description": "One-line description shown on the knowledge hub card."
    },
    "order": {
      "type": "integer",
      "minimum": 1,
      "description": "Position of this domain on the hub page."
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$",
            "description": "Globally unique topic id — the deep-link target used by kb: links."
          },
          "kind": {
            "enum": ["theory", "skill", "spec"],
            "description": "theory = concept to understand; skill = technique to perform; spec = reference for a component or tool."
          },
          "name": { "type": "string", "minLength": 2, "description": "Short display name." },
          "question": {
            "$ref": "blocks.schema.json#/$defs/richText",
            "description": "The deeper question this topic answers, shown under the name."
          },
          "asset": { "$ref": "blocks.schema.json#/$defs/assetPath" },
          "assetAlt": { "type": "string", "minLength": 3 },
          "summary": { "$ref": "blocks.schema.json#/$defs/richText" },
          "keywords": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Search terms; never displayed."
          },
          "sections": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "heading": { "$ref": "blocks.schema.json#/$defs/richText" },
                "paragraphs": { "$ref": "blocks.schema.json#/$defs/paragraphs" }
              },
              "required": ["heading", "paragraphs"],
              "additionalProperties": false
            }
          },
          "hint": {
            "$ref": "blocks.schema.json#/$defs/richText",
            "description": "Scenario hint connecting the topic back to lab troubleshooting."
          },
          "related": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
            "description": "Ids of connected topics. The build fails on a dangling reference."
          }
        },
        "required": ["id", "kind", "name", "summary", "sections"],
        "additionalProperties": false
      }
    }
  },
  "required": ["schemaVersion", "id", "title", "blurb", "order", "topics"],
  "additionalProperties": false
}
